<!DOCTYPE html>
<html lang="ja">

<head>
    <meta charset="UTF-8">
    <title>作業詳細</title>

    <link rel="stylesheet" href="/css/style.css">


</head>

<body>

<header>
    <h1>作業詳細</h1>
</header>

<main class="detail-main">

    <form id="placeForm">

		<div class="form-group">
		    <label for="place">園地</label>
		    <input type="text" id="place" required>
		</div>

		<div class="form-group">
		    <label for="date">日付</label>
		    <input type="date" id="date" required>
		</div>

		<div class="form-group">
		    <label for="name">作業内容</label>
		    <input type="text" id="name" required>
		</div>

		<div class="form-group">
		    <label for="worker">作業者</label>
		    <input type="text" id="worker" required>
		</div>

		<div class="form-group">
		    <label for="remarks">備考</label>
		    <textarea id="remarks"></textarea>
		</div>

        <button type="submit">
            更新する
        </button>

        <button type="button"
                class="delete"
                onclick="deletePlace()">
            削除する
        </button>

        <button type="button"
                class="back"
                onclick="location.href='/place.html'">
            一覧へ戻る
        </button>

        <div class="message" id="message"></div>

    </form>

</main>

<script>

    // URLからidを取得
    const params = new URLSearchParams(window.location.search);

    const id = params.get('id');


    // 作業詳細を取得
    function loadPlace() {

        fetch('/place/' + id)
            .then(response => {

                if (!response.ok) {
                    throw new Error('作業情報が見つかりません');
                }

                return response.json();
            })
            .then(place => {

                document.getElementById('placeId').value =
                    place.placeId;

                document.getElementById('name').value =
                    place.name;

                document.getElementById('date').value =
                    place.date;

                document.getElementById('place').value =
                    place.place;

                document.getElementById('remarks').value =
    		    place.remarks;
            })
            .catch(error => {

                document.getElementById('message').textContent =
                    error.message;
            });
    }


    // 更新処理
    document.getElementById('placeForm')
        .addEventListener('submit', function(event) {

            event.preventDefault();

            const place = {

    		place: document.getElementById('place').value,

    		date: document.getElementById('date').value,

    		name: document.getElementById('name').value,

    		worker: document.getElementById('worker').value,

    		remarks: document.getElementById('remarks').value
	    };


            // PUT /place/{id}
            fetch('/place/' + id, {

                method: 'PUT',

                headers: {
                    'Content-Type': 'application/json'
                },

                body: JSON.stringify(place)

            })
            .then(response => {

                if (!response.ok) {
                    throw new Error('更新に失敗しました');
                }

                return response.json();
            })
            .then(data => {

                alert('作業情報を更新しました');

                location.href = '/place.html';
            })
            .catch(error => {

                document.getElementById('message').textContent =
                    error.message;
            });

        });


    // 削除処理
    function deletePlace() {

        if (!confirm('この作業を削除しますか？')) {
            return;
        }

        // DELETE /place/{id}
        fetch('/place/' + id, {

            method: 'DELETE'

        })
        .then(response => {

            if (!response.ok) {
                throw new Error('削除に失敗しました');
            }

            return response.text();
        })
        .then(message => {

            alert(message);

            location.href = '/place.html';
        })
        .catch(error => {

            document.getElementById('message').textContent =
                error.message;
        });
    }


    // ページを開いたときに詳細を取得
    loadPlace();

</script>

</body>
</html>